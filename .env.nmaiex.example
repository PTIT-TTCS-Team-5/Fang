# ============================================================
# [NMAIex] Environment — NMAIex Ranking System
# Sync với app/core/nmaiex_config.py - 9:38 03/05/2026
# ============================================================

# --- Cloud Storage (Cloudinary dùng CHUNG cho TTCS và NMAIex) ---
# Account Cloudinary là tài khoản chung. Mỗi project upload vào folder riêng.
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET → đặt tại .env gốc
# CLOUDINARY_UPLOAD_FOLDER → đặt tại .env gốc (dùng chung, thay đổi giá trị khi switch project)

# ============================================================
# Luồng J→C: Nhà tuyển dụng tìm ứng viên (ưu tiên Precision/MRR)
# Tổng w_rrf + w_skill = 0.70 (có chủ ý < 1, room 0.30 cho seniority penalty)
# ============================================================
NMAIEX_JC_WEIGHT_RRF=0.30
NMAIEX_JC_WEIGHT_SKILL=0.40

# ============================================================
# Luồng C→J: Ứng viên tìm công việc (ưu tiên Recall/nDCG@10)
# Tổng w_rrf + w_title + w_skill = 0.80 (room 0.20 cho salary + language)
# ============================================================
NMAIEX_CJ_WEIGHT_RRF=0.35
NMAIEX_CJ_WEIGHT_TITLE=0.15
NMAIEX_CJ_WEIGHT_SKILL=0.30

# ============================================================
# RRF Config
# ============================================================
NMAIEX_RRF_K=60
NMAIEX_RANKING_DEFAULT_LIMIT=20
NMAIEX_RANKING_MAX_LIMIT=100

# ============================================================
# Tiered Skill Matching (Strategy C: Exact + Fuzzy)
# alpha=0.8 → exact overlap được ưu tiên 4x hơn fuzzy
# embedding_dims=256: Matryoshka truncation, đủ cho text ngắn (1-5 từ)
# ============================================================
NMAIEX_SKILL_ALPHA=0.8
NMAIEX_SKILL_EMBEDDING_DIMS=256

# ============================================================
# Seniority Penalty — Asymmetric Buffer (J→C)
# Coef: 0.25/năm thiếu; thừa nhẹ hơn 2x (ratio 0.5)
# Buffer: job_max = job_max_raw + buffer theo career tier
# ============================================================
NMAIEX_JC_PENALTY_SENIORITY_COEF=0.25
NMAIEX_SENIORITY_OVERQUALIFIED_PENALTY_RATIO=0.5
NMAIEX_BUFFER_VERY_JUNIOR=2
NMAIEX_BUFFER_JUNIOR=3
NMAIEX_BUFFER_MIDDLE=4
NMAIEX_BUFFER_SENIOR=5
NMAIEX_BUFFER_LEAD_MANAGER=7

# ============================================================
# Salary Adjustment — C→J (Asymmetric Linear)
# Base salary theo địa điểm (VND/tháng) — dùng khi CV không ghi expected salary
# Increment theo tier kinh nghiệm (VND/năm thêm)
# Neutral zone: [expected*0.80, expected*1.20] → salary_adjustment = 0.0
# ============================================================
NMAIEX_SALARY_BASE_HANOI=15000000
NMAIEX_SALARY_BASE_TPHCM=14000000
NMAIEX_SALARY_BASE_DANANG=12000000
NMAIEX_SALARY_BASE_DEFAULT=13000000
NMAIEX_SALARY_INCREMENT_JUNIOR=1500000
NMAIEX_SALARY_INCREMENT_MIDDLE=2000000
NMAIEX_SALARY_INCREMENT_SENIOR=2500000
NMAIEX_SALARY_INCREMENT_LEAD=3000000
NMAIEX_SALARY_TOLERANCE_LOWER=0.8
NMAIEX_SALARY_TOLERANCE_UPPER=1.2
NMAIEX_SALARY_BONUS_CAP=0.2

# ============================================================
# Language Requirement Scoring — C→J
# 5 bậc chuẩn: BASIC(1) | INTERMEDIATE(2) | ADVANCED(3) | FLUENT(4) | NATIVE(5)
# Tiếng Việt không được đưa vào JOB_LANG_REQUIREMENT (mặc định của thị trường nội địa)
# ============================================================
NMAIEX_LANG_REQUIRED_PENALTY=0.25
NMAIEX_LANG_LEVEL_PENALTY=0.10
NMAIEX_LANG_PREFERRED_BONUS=0.08
NMAIEX_LANG_BONUS_CAP=0.15

# ============================================================
# Score Clipping Control
# Default false keeps raw ranking scores sortable outside [0, 1].
# Set true only if a legacy UI requires bounded percentage-like scores.
# ============================================================
NMAIEX_ENABLE_SCORE_CLIP=false
