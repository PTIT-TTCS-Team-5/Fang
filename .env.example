# Database Configuration
DATABASE_URL=

# Embedding Configuration
EMBEDDING_DIM=1536
EMBEDDING_PROVIDER=openai

# Parser Provider API Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Parser Retry Policy
PARSER_RETRY_ENABLED=true
PARSER_RETRY_ATTEMPTS=3
PARSER_RETRY_BASE_SECONDS=2
PARSER_RETRY_MAX_SECONDS=8

# Parser Quality Gate
PARSER_QUALITY_MIN_RAWTEXT_LENGTH=120
PARSER_QUALITY_MIN_SECTION_SIGNALS=1

# App Config
LOG_LEVEL=INFO
