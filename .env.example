# ============================================================
# FANG Environment Configuration
# Lưu ý: File này là mẫu, ae clone dự án về nhân bản file nà
# Đổi tên thành .env và thay các biến thật vào
# Sau khi đã thay biến thật thì sẽ chỉ sửa local, không commit .env
# ============================================================

# ============================================================
# 1. DATABASE
# ============================================================
# Format: postgresql://username:password@hostname:port/database
# Example: postgresql://postgres:yourpassword@localhost:5432/micareer_lite_db
DATABASE_URL=

# ============================================================
# 2. EMBEDDING (AI Chunking & Vector Search)
# ============================================================
EMBEDDING_DIM=1536
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BATCH_SIZE=32
EMBEDDING_VECTOR_TYPE=halfvec

# ============================================================
# 3. LLM PROVIDER API KEYS
# ============================================================

# Tạo tài khoản Google AI studio và lấy API gắn vào 
GOOGLE_API_KEY=

# Cái này đợi Hưng hướng dẫn nhe để chia vào tổ chức
OPENAI_API_KEY=

# Ae lấy ở Claude Platform nhé, đừng nạp credit vào cứ gắn trong dự án xem có bị ban không. Như t là bị ban rồi :b
CLAUDE_API_KEY=

# Optional: local 9Router / OpenAI-compatible proxy for model listing and safety eval scripts
NINE_ROUTER_URL=http://localhost:20128/v1
NINE_ROUTER_KEY=

# ============================================================
# 4. CLOUD STORAGE (Cloudinary)
# ============================================================
# Ae đăng ký Cloudinary, tạo sẵn ở Home thư mục tên 'ttcs' và enable PDF nhé. Rồi lấy API gẵn vào thôi 
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=changeme
CLOUDINARY_API_SECRET=changeme

# ============================================================
# 5. PARSER RETRY POLICY
# ============================================================
# Config khi model bị lỗi, tự động retry với exponential backoff
PARSER_RETRY_ENABLED=true
PARSER_RETRY_ATTEMPTS=3
PARSER_RETRY_BASE_SECONDS=2
PARSER_RETRY_MAX_SECONDS=8

# ============================================================
# 6. PARSER QUALITY GATE
# ============================================================
# Nếu output không đáp ứng thì escalate sang Pro tier
# Output model dưới ngưỡng này thì bị coi là hỏng
PARSER_QUALITY_MIN_RAWTEXT_LENGTH=120
# Ít nhất một Model hỏng (lỗi quality) thì mới xét leo Pro tier
PARSER_QUALITY_MIN_SECTION_SIGNALS=1
# Low parser self-report confidence triggers quality fallback.
# Missing parserSelfReport does not fail, preserving legacy parsedJson compatibility.
PARSER_QUALITY_MIN_SELF_CONFIDENCE=0.55

# ============================================================
# 7. RAG QUERY / GENERATION
# ============================================================
RAG_TOP_K_CHUNKS=3
RAG_GENERATION_RETRY_ENABLED=true
RAG_GENERATION_RETRY_ATTEMPTS=3
RAG_GENERATION_RETRY_BASE_SECONDS=1
RAG_GENERATION_RETRY_MAX_SECONDS=6

# ============================================================
# 8. CONTEXT WINDOW MANAGEMENT
# ============================================================
CONTEXT_BUDGET_LITE=180000
CONTEXT_BUDGET_PRO=960000
CONTEXT_BUDGET_WARNING_THRESHOLD=0.80
CONTEXT_SUMMARIZATION_MODEL=gemini-flash

# ============================================================
# 9. APP CONFIG
# ============================================================
LOG_LEVEL=INFO
CLOUDINARY_UPLOAD_FOLDER="ttcs"
CORS_ALLOWED_ORIGINS=["*"]
