# Database Configuration
DATABASE_URL=

# Embedding Configuration
EMBEDDING_DIM=1024
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_BATCH_SIZE=32
EMBEDDING_VECTOR_TYPE=halfvec

# Parser Provider API Keys
GOOGLE_API_KEY=
OPENAI_API_KEY=
CLAUDE_API_KEY=

# Parser Retry Policy
PARSER_RETRY_ENABLED=true
PARSER_RETRY_ATTEMPTS=3
PARSER_RETRY_BASE_SECONDS=2
PARSER_RETRY_MAX_SECONDS=8

# Parser Quality Gate
PARSER_QUALITY_MIN_RAWTEXT_LENGTH=120
PARSER_QUALITY_MIN_SECTION_SIGNALS=1

# App Config
LOG_LEVEL=INFO
TTCS_CLOUDINARY_UPLOAD_FOLDER="ttcs"
