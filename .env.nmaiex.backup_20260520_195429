# ============================================================
# [NMAIex] Environment — NMAIex Ranking System
# ============================================================

# --- Cloud Storage (Cloudinary dùng CHUNG cho TTCS và NMAIex) ---
# Account Cloudinary là tài khoản chung. Mỗi project upload vào folder riêng.
# Thư mục đã tạo sẵn trên Cloudinary Home: Home/ttcs và Home/nmaiex
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET → đặt tại .env gốc
# Biến dưới đây chỉ định folder đích khi upload từ NMAIex:
NMAIEX_CLOUDINARY_UPLOAD_FOLDER="nmaiex"

# ============================================================
# --- Weights J→C (HR tìm ứng viên — ưu tiên Precision/MRR) ---
# ============================================================
NMAIEX_JC_WEIGHT_RRF=0.4219
NMAIEX_JC_WEIGHT_SKILL=0.5329
NMAIEX_JC_PENALTY_SENIORITY_COEF=0.4255

# ============================================================
# --- Weights C→J (Ứng viên tìm việc — ưu tiên Recall/nDCG@10) ---
# Room 0.20 còn lại (1 - 0.35 - 0.15 - 0.30 = 0.20) = salary_adjustment
# clip(0,1) đảm bảo điểm hợp lệ dù penalty/bonus lớn
# ============================================================
NMAIEX_CJ_WEIGHT_RRF=0.35
NMAIEX_CJ_WEIGHT_TITLE=0.15
NMAIEX_CJ_WEIGHT_SKILL=0.30

# ============================================================
# --- RRF Config ---
# ============================================================
NMAIEX_RRF_K=60
NMAIEX_RANKING_DEFAULT_LIMIT=20
NMAIEX_RANKING_MAX_LIMIT=100

# ============================================================
# --- Strategy C: Tiered Skill Matching ---
# ============================================================
# 256 dims đủ cho skill text ngắn (1-5 từ), rẻ hơn 4x so với 1024
# text-embedding-3-small hỗ trợ giảm chiều Matryoshka nên không mất quality đáng kể
NMAIEX_SKILL_EMBEDDING_DIMS=256

# Alpha = trọng số cho exact overlap trong công thức:
# skill_score = alpha * exact_overlap + (1-alpha) * fuzzy_overlap
# alpha=0.8: ưu tiên exact match (catalog skill) nhưng fuzzy vẫn đóng góp 20%
NMAIEX_SKILL_ALPHA=0.7362

# ============================================================
# --- Seniority Penalty — Asymmetric Buffer-based (Phase 2.5b) ---
# Tham chiếu: [NMAIex]_SENIORITY_PENALTY_PROPOSAL.md
# ============================================================
# Overqualified ratio: phạt thừa = ratio × base coef (0.5 = phạt ½ so với thiếu)
NMAIEX_SENIORITY_OVERQUALIFIED_PENALTY_RATIO=0.1134
# Buffer years per career path tier (job_max = job_max_raw + buffer)
NMAIEX_BUFFER_VERY_JUNIOR=2      # job_max_raw ≤ 1 năm (Intern/Fresher)
NMAIEX_BUFFER_JUNIOR=3           # job_max_raw 1-3 năm (Junior)
NMAIEX_BUFFER_MIDDLE=4           # job_max_raw 3-5 năm (Middle)
NMAIEX_BUFFER_SENIOR=5           # job_max_raw 5-8 năm (Senior)
NMAIEX_BUFFER_LEAD_MANAGER=7     # job_max_raw > 8 năm (Lead/Manager)

# ============================================================
# --- Salary Adjustment — C→J (Phase 2.5d) ---
# Salary base theo địa điểm (VND/tháng) — fallback khi CV không có expected salary
# Cập nhật thường xuyên theo mặt bằng lương thị trường VN (tham khảo AI_MANUAL_UPDATE.md)
# ============================================================
NMAIEX_SALARY_BASE_HANOI=15_000_000
NMAIEX_SALARY_BASE_TPHCM=14_000_000
NMAIEX_SALARY_BASE_DANANG=12_000_000
NMAIEX_SALARY_BASE_DEFAULT=13_000_000
# Increment per tier (VND/năm kinh nghiệm thêm)
NMAIEX_SALARY_INCREMENT_JUNIOR=1_500_000
NMAIEX_SALARY_INCREMENT_MIDDLE=2_000_000
NMAIEX_SALARY_INCREMENT_SENIOR=2_500_000
NMAIEX_SALARY_INCREMENT_LEAD=3_000_000
# Tolerance band: [expected*lower, expected*upper] → neutral zone (không phạt, không bonus)
NMAIEX_SALARY_TOLERANCE_LOWER=0.8
NMAIEX_SALARY_TOLERANCE_UPPER=1.2
# Cap bonus tối đa nếu lương job cao hơn kỳ vọng của ứng viên
NMAIEX_SALARY_BONUS_CAP=0.2

# ============================================================
# --- Language Requirement Scoring (Phase 2.5g) ---
# ============================================================
NMAIEX_LANG_REQUIRED_PENALTY=0.25    # Thiếu REQUIRED language → -0.25
NMAIEX_LANG_LEVEL_PENALTY=0.10       # Có language nhưng level không đủ → -0.10
NMAIEX_LANG_PREFERRED_BONUS=0.08     # Có PREFERRED language đủ level → +0.08
NMAIEX_LANG_BONUS_CAP=0.15           # Tổng bonus ngôn ngữ tối đa

# --- Score Clipping (Tắt clip [0, 1] cho dev mode / tuning) ---
NMAIEX_ENABLE_SCORE_CLIP=False
