    {
      "name": "Smoke Tests",
      "item": [
        {
          "name": "Test Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Verify API is running"
          },
          "response": []
        },
        {
          "name": "Test Chat → Ingestion → Ranking Flow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"description\": \"Full pipeline test: Parse CV → Store → Query Chat → Get Ranking\",\n    \"steps\": [\n        \"1. POST /v2/ingestion/jobs (parse CV)\",\n        \"2. GET /v2/ingestion/jobs/{id} (wait for SUCCESS)\",\n        \"3. POST /v2/chat/query (query with context)\",\n        \"4. GET /v2/nmaiex/ranking/candidates/{job_id} (verify ranking)\"\n    ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/v2/chat/query",
              "host": ["{{base_url}}"],
              "path": ["v2", "chat", "query"]
            },
            "description": "Manual test flow (follow steps in body)"
          },
          "response": []
        }
      ]
    },
    {
      "name": "JobPosting Agent API",
      "description": "C3 JobPosting Agent smoke tests — POST /v2/agent/job-posting/query + conversations",
      "item": [
        {
          "name": "Case 2: POST /v2/agent/job-posting/query — Top Candidates",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jobPostId\": {{job_post_id}},\n    \"hrId\": {{hr_id}},\n    \"prompt\": \"Liệt kê top 10 ứng viên phù hợp nhất cho job này, nêu lý do ngắn gọn.\",\n    \"conversationId\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/v2/agent/job-posting/query",
              "host": ["{{base_url}}"],
              "path": ["v2", "agent", "job-posting", "query"]
            },
            "description": "Smoke Case 2. Save conversationId from response as {{conversation_id}}. Requires active Gemini API quota."
          },
          "response": []
        },
        {
          "name": "Case 3: POST /v2/agent/job-posting/query — Language Filter",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jobPostId\": {{job_post_id}},\n    \"hrId\": {{hr_id}},\n    \"prompt\": \"Trong nhóm ứng viên này, lọc những người có tiếng Anh hạng C trở lên hoặc tương đương advanced trở lên.\",\n    \"conversationId\": \"{{conversation_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v2/agent/job-posting/query",
              "host": ["{{base_url}}"],
              "path": ["v2", "agent", "job-posting", "query"]
            },
            "description": "Smoke Case 3. Requires {{conversation_id}} set from Case 2. Tests multi-turn + language filter tool."
          },
          "response": []
        },
        {
          "name": "Case 4: POST /v2/agent/job-posting/query — CV Drill-down",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jobPostId\": {{job_post_id}},\n    \"hrId\": {{hr_id}},\n    \"prompt\": \"Xem chi tiết CV đã mask PII của ứng viên jobAppId={{job_app_id}} và tóm tắt điểm mạnh/yếu.\",\n    \"conversationId\": \"{{conversation_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v2/agent/job-posting/query",
              "host": ["{{base_url}}"],
              "path": ["v2", "agent", "job-posting", "query"]
            },
            "description": "Smoke Case 4. PII masking check: response must not expose raw email/phone/address."
          },
          "response": []
        },
        {
          "name": "Case 5a: GET /v2/agent/job-posting/conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/agent/job-posting/conversations?jobPostId={{job_post_id}}&hrId={{hr_id}}",
              "host": ["{{base_url}}"],
              "path": ["v2", "agent", "job-posting", "conversations"],
              "query": [
                {"key": "jobPostId", "value": "{{job_post_id}}"},
                {"key": "hrId", "value": "{{hr_id}}"}
              ]
            },
            "description": "Smoke Case 5a. Verified PASS 2026-05-29: HTTP 200, returned 4 active conversations."
          },
          "response": []
        },
        {
          "name": "Case 5b: GET /v2/agent/job-posting/conversations/{id}/messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/agent/job-posting/conversations/{{conversation_id}}/messages",
              "host": ["{{base_url}}"],
              "path": ["v2", "agent", "job-posting", "conversations", "{{conversation_id}}", "messages"]
            },
            "description": "Smoke Case 5b. Verified PASS 2026-05-29: HTTP 200, 4 messages (user/assistant/tool_call/tool_result)."
          },
          "response": []
        },
        {
          "name": "Case 6: POST /v2/agent/job-posting/query — Negative 403 Scope",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jobPostId\": 3,\n    \"hrId\": 2,\n    \"prompt\": \"test scope mismatch — should be rejected\",\n    \"conversationId\": null\n}"
            },
            "url": {
              "raw": "{{base_url}}/v2/agent/job-posting/query",
              "host": ["{{base_url}}"],
              "path": ["v2", "agent", "job-posting", "query"]
            },
            "description": "Smoke Case 6. hrId=2 (companyId=1) + jobPostId=3 (companyId=2). Verified PASS 2026-05-29: HTTP 403."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "job_post_id",
      "value": "1",
      "type": "string",
      "description": "Valid jobPostId from DB (companyId=1, 500 applications)"
    },
    {
      "key": "hr_id",
      "value": "2",
      "type": "string",
      "description": "Valid hrId from DB (belongs to companyId=1)"
    },
    {
      "key": "conversation_id",
      "value": "",
      "type": "string",
      "description": "Set after running Case 2 (POST query). Example: 1a858940-a53b-4644-968e-65e121c9d14a"
    },
    {
      "key": "job_app_id",
      "value": "1",
      "type": "string",
      "description": "Valid jobAppId from DB for jobPostId=1 (candidateId=18)"
    }
  ]
}
