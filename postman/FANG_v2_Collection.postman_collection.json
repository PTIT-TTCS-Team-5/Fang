{
  "info": {
    "_postman_id": "fang-v2-collection",
    "name": "FANG v2 API Test Suite",
    "description": "Complete API test collection for FANG v2 (Chat, Ingestion, NMAIex Ranking, Master Data)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Chat API",
      "item": [
        {
          "name": "POST /v2/chat/query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jobAppId\": {{job_app_id_full_cv}},\n    \"hrId\": {{hr_id}},\n    \"prompt\": \"Dựa trên toàn bộ CV, ứng viên này phù hợp với vị trí ở những điểm nào? Nêu evidence theo nguồn.\",\n    \"conversationId\": null,\n    \"modelMode\": \"auto-lite\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v2/chat/query",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "chat",
                "query"
              ]
            },
            "description": "Send a query to FANG full-CV chat. Expected: HTTP 200, topK=0, UUID conversationId, non-empty response."
          },
          "response": []
        },
        {
          "name": "GET /v2/chat/conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/chat/conversations?hrId={{hr_id}}&jobAppId={{job_app_id_full_cv}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "chat",
                "conversations"
              ],
              "query": [
                {
                  "key": "hrId",
                  "value": "{{hr_id}}"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Get list of conversations for an HR"
          },
          "response": []
        },
        {
          "name": "GET /v2/chat/conversations/{id}/messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/chat/conversations/{{conversation_id}}/messages",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "chat",
                "conversations",
                "{{conversation_id}}",
                "messages"
              ]
            },
            "description": "Get message history for a conversation"
          },
          "response": []
        },
        {
          "name": "POST /v2/chat/conversations/{id}/summarize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/v2/chat/conversations/{{conversation_id}}/summarize",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "chat",
                "conversations",
                "{{conversation_id}}",
                "summarize"
              ]
            },
            "description": "Summarize old conversation history to reduce token usage"
          },
          "response": []
        },
        {
          "name": "POST /v2/chat/conversations/{id}/branch-new",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{}"
            },
            "url": {
              "raw": "{{base_url}}/v2/chat/conversations/{{conversation_id}}/branch-new",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "v2",
                "chat",
                "conversations",
                "{{conversation_id}}",
                "branch-new"
              ]
            },
            "description": "Create a new conversation with summary from old one"
          },
          "response": []
        }
      ]
    },
