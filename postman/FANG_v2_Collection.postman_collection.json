  "item": [
    {
      "name": "Chat API",
      "item": [
        {
          "name": "POST /v2/chat/query",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"jobAppId\": 1,\n    \"hrId\": 1,\n    \"prompt\": \"Ứng viên này có kinh nghiệm AI/ML không?\",\n    \"conversationId\": null,\n    \"modelMode\": \"auto-lite\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v2/chat/query",
              "host": ["{{base_url}}"],
              "path": ["v2", "chat", "query"]
            },
            "description": "Send a query to FANG chat with RAG context"
          },
          "response": []
        },
        {
          "name": "GET /v2/chat/conversations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/chat/conversations?hrId=1&limit=20&offset=0",
              "host": ["{{base_url}}"],
              "path": ["v2", "chat", "conversations"],
              "query": [
                {
                  "key": "hrId",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Get list of conversations for an HR"
          },
          "response": []
        },
        {
          "name": "GET /v2/chat/conversations/{id}/messages",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/chat/conversations/a1b2c3d4-5e6f-7890-abcd-ef1234567890/messages",
              "host": ["{{base_url}}"],
              "path": ["v2", "chat", "conversations", "a1b2c3d4-5e6f-7890-abcd-ef1234567890", "messages"]
            },
            "description": "Get message history for a conversation"
          },
          "response": []
        },
        {
          "name": "POST /v2/chat/conversations/{id}/summarize",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"conversationId\": \"a1b2c3d4-5e6f-7890-abcd-ef1234567890\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v2/chat/conversations/a1b2c3d4-5e6f-7890-abcd-ef1234567890/summarize",
              "host": ["{{base_url}}"],
              "path": ["v2", "chat", "conversations", "a1b2c3d4-5e6f-7890-abcd-ef1234567890", "summarize"]
            },
            "description": "Summarize old conversation history to reduce token usage"
          },
          "response": []
        },
        {
          "name": "POST /v2/chat/conversations/{id}/branch-new",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"conversationId\": \"a1b2c3d4-5e6f-7890-abcd-ef1234567890\",\n    \"hrId\": 1\n}"
            },
            "url": {
              "raw": "{{base_url}}/v2/chat/conversations/a1b2c3d4-5e6f-7890-abcd-ef1234567890/branch-new",
              "host": ["{{base_url}}"],
              "path": ["v2", "chat", "conversations", "a1b2c3d4-5e6f-7890-abcd-ef1234567890", "branch-new"]
            },
            "description": "Create a new conversation with summary from old one"
          },
          "response": []
        }
      ]
    },
