              "raw": "{\n    \"cvUrl\": \"https://res.cloudinary.com/micareer/image/upload/v1234567890/cv_abc123.pdf\",\n    \"candidateId\": 1,\n    \"jobAppId\": 1,\n    \"modelMode\": \"auto-lite\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/v2/ingestion/jobs",
