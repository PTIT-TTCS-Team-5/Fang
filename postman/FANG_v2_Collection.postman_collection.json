        {
          "name": "GET /v2/nmaiex/ranking/jobs/{candidate_id}",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v2/nmaiex/ranking/jobs/1?limit=20&province_id=HANOI&work_mode=REMOTE",
              "host": ["{{base_url}}"],
              "path": ["v2", "nmaiex", "ranking", "jobs", "1"],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "province_id",
                  "value": "HANOI"
                },
                {
                  "key": "work_mode",
                  "value": "REMOTE"
